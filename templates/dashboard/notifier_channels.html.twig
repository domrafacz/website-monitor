{% import 'dashboard/_includes/_alerts.html.twig' as alerts %}
{% extends 'base.html.twig' %}

{% block title %}{{ 'notifier_channels_title'|trans }}{% endblock %}

{% block body %}
    {% include('dashboard/_sidebar.html.twig') %}
    <div class="md:ml-64 flex flex-col min-h-screen">
        {% include('dashboard/_navbar.html.twig') %}
        <main class="flex-grow p-4 dark:bg-gray-900">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-200 mb-4">{{ 'notifier_channels_title'|trans }}</h3>
            {% include('dashboard/_flash_messages.html.twig') %}
            <div>
                <a href="{{ path('app_notifier_add_channel') }}" class="dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800 text-white bg-green-700 hover:bg-green-800 focus:outline-none focus:ring-4 focus:ring-green-300 font-normal py-2 px-4 rounded mb-3">{{ 'add'|trans }}</a>
                {% if notifier_channels.count == 0 %}
                    <div class="mt-4">
                        {{ alerts.warning('', 'empty_notification_channel_list_message'|trans) }}
                    </div>
                {% else %}
                    <div class="bg-white dark:bg-gray-800 p-4 shadow-md rounded-lg mt-4 border dark:border-0">
                        <div class="overflow-x-auto">
                            <table class="min-w-full bg-white dark:bg-gray-800">
                                <thead class="bg-gray-100 dark:bg-gray-700">
                                    <tr>
                                        <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">{{ 'notifier_channel_name'|trans }}</th>
                                        <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">{{ 'channel_type'|trans }}</th>
                                        <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">{{ 'channel_options'|trans }}</th>
                                        <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-right text-gray-700 uppercase dark:text-gray-400">{{ 'options'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700">
                                {% for channel in notifier_channels.getIterator %}
                                    <tr class="hover:bg-gray-100 dark:hover:bg-gray-700">
                                        {% include 'dashboard/notifier/channels/_name_row.html.twig' %}
                                        {% include 'dashboard/notifier/channels/_' ~ channels_types[channel.type].name|lower ~ '_row.html.twig' %}
                                        {% include 'dashboard/notifier/channels/_options_row.html.twig' %}
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endif %}
            </div>
        </main>
    </div>
{% endblock %}
