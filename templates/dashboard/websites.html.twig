{% import 'dashboard/_includes/_alerts.html.twig' as alerts %}

{% extends 'base.html.twig' %}

{% block title %}{{ 'websites_title'|trans }}{% endblock %}

{% block body %}
    {% include('dashboard/_sidebar.html.twig') %}
    <div class="md:ml-64 flex flex-col min-h-screen">
        {% include('dashboard/_navbar.html.twig') %}
        <main class="flex-grow p-4 dark:bg-gray-900">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
                <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-200">{{ 'websites_title'|trans }}</h3>
                <div class="mt-2 sm:mt-0">
                    <div class="flex items-center gap-3">
                        <span class="text-sm text-gray-600 dark:text-gray-400">{{ 'quota'|trans }}:</span>
                        <div class="flex items-center gap-2">
                            <div class="w-32 h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                                {% set usage_percent = (websites.count / app.user.quota * 100)|round %}
                                <div class="h-full rounded-full transition-all duration-300 {% if websites.count >= app.user.quota %}bg-red-500{% elseif usage_percent >= 80 %}bg-yellow-500{% else %}bg-green-500{% endif %}" style="width: {{ usage_percent > 100 ? 100 : usage_percent }}%"></div>
                            </div>
                            <span class="text-sm font-medium {% if websites.count >= app.user.quota %}text-red-600 dark:text-red-400{% elseif usage_percent >= 80 %}text-yellow-600 dark:text-yellow-400{% else %}text-gray-700 dark:text-gray-300{% endif %}">
                                {{ websites.count }}/{{ app.user.quota }}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            {% include('dashboard/_flash_messages.html.twig') %}
            {% if websites.count >= app.user.quota %}
                <button class="bg-gray-300 text-gray-500 font-normal py-2 px-4 rounded mb-3 cursor-not-allowed" disabled>{{ 'add'|trans }}</button>
                <div class="mt-4">
                    {{ alerts.warning('', 'exceeded_quota_message'|trans) }}
                </div>
            {% else %}
                <a href="{{ path('app_website_add') }}" class="dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800 text-white bg-green-700 hover:bg-green-800 focus:outline-none focus:ring-4 focus:ring-green-300 font-normal py-2 px-4 rounded mb-3 transition duration-200 ease-in-out">{{ 'add'|trans }}</a>
            {% endif %}
            {% if websites.count == 0 %}
                <div class="mt-4">
                    {{ alerts.warning('', 'empty_website_list_message'|trans) }}
                </div>
            {% else %}
                <div class="mt-4 border dark:border-0">
                    <div class="bg-white dark:bg-gray-800 p-4 shadow-md rounded-lg">
                        <div class="overflow-x-auto">
                            <table class="min-w-full bg-white dark:bg-gray-800">
                                <thead class="bg-gray-100 dark:bg-gray-700">
                                <tr>
                                    <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">{{ 'url'|trans }}</th>
                                    <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">{{ 'status'|trans }}</th>
                                    <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">{{ 'notification_channels'|trans }}</th>
                                    <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">{{ 'last_status'|trans }}</th>
                                    <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">{{ 'last_check'|trans }}</th>
                                    <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">{{ 'ssl_expire_time'|trans }}</th>
                                </tr>
                                </thead>
                                <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700">
                                {% for website in websites %}
                                    <tr class="hover:bg-blue-100 dark:hover:bg-gray-700">
                                        <td class="py-4 px-6 text-sm font-medium text-gray-900 whitespace-nowrap dark:text-white">
                                            <a href="{{ path('app_website_details', {id: website.getId}) }}" class="text-blue-600 dark:text-blue-400 hover:underline">
                                                {{ website.getUrl }}
                                            </a>
                                        </td>
                                        <td class="py-4 px-6 text-sm text-gray-500 whitespace-nowrap dark:text-gray-400">
                                            <div class="flex items-center gap-2">
                                                {% if website.isEnabled == true %}
                                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-600 text-white">{{ 'enabled'|trans }}</span>
                                                {% else %}
                                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">{{ 'disabled'|trans }}</span>
                                                {% endif %}
                                                <a href="{{ path('app_website_toggle_enabled', {id: website.getId, token: csrf_token('website-toggle-enabled')}) }}" 
                                                   class="p-1 rounded hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors" 
                                                   title="{{ website.isEnabled ? 'disable'|trans : 'enable'|trans }}">
                                                    {% if website.isEnabled %}
                                                        <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                                        </svg>
                                                    {% else %}
                                                        <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                                        </svg>
                                                    {% endif %}
                                                </a>
                                            </div>
                                        </td>
                                        <td class="py-4 px-6 text-sm text-gray-500 whitespace-nowrap dark:text-gray-400">
                                            {% set channel_count = website.getNotifierChannels|length %}
                                            <div class="flex items-center gap-2">
                                                {% if channel_count == 0 %}
                                                    <svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 20 20" title="{{ 'no_notification_channels_warning'|trans }}">
                                                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                                    </svg>
                                                    <span class="text-yellow-600 dark:text-yellow-400">{{ channel_count }}</span>
                                                {% else %}
                                                    <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                                                    </svg>
                                                    <span class="text-green-600 dark:text-green-400">{{ channel_count }}</span>
                                                {% endif %}
                                            </div>
                                        </td>
                                        <td class="py-4 px-6 text-sm text-gray-500 whitespace-nowrap dark:text-gray-400">
                                            {% if website.getLastStatus == constant('STATUS_OK', website) %}
                                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-600 text-white">Ok</span>
                                            {% else %}
                                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">{{ 'error'|trans }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="py-4 px-6 text-sm text-gray-500 whitespace-nowrap dark:text-gray-400">
                                            {% if website.getLastCheck is null %}
                                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">{{ 'unavailable'|trans }}</span>
                                            {% else %}
                                                {{ website.getLastCheck|ago }}
                                            {% endif %}
                                        </td>
                                        <td class="py-4 px-6 text-sm text-gray-500 whitespace-nowrap dark:text-gray-400">
                                            {% if website.getCertExpiryTime is null %}
                                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-300 text-gray-800">{{ 'unavailable'|trans }}</span>
                                            {% else %}
                                                {% if date('now') > website.getCertExpiryTime %}
                                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">{{ website.getCertExpiryTime|ago }}</span>
                                                {% else %}
                                                    {{ website.getCertExpiryTime|ago }}
                                                {% endif %}
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endif %}
        </main>
    </div>
{% endblock %}
