<td class="py-4 px-6 text-sm text-gray-500 whitespace-nowrap dark:text-gray-400">
    {{ channels_types[channel.type].name }}
</td>
<td class="py-4 px-6 text-sm text-gray-500 whitespace-nowrap dark:text-gray-400">
    <span class="font-semibold">{{ 'matrix_server_url'|trans }}:</span> {{ channel.options.serverUrl|default(null) }}<br>
