{% extends 'base.html.twig' %}

{% block title %}{{ 'notifier_add_channel_title'|trans }}{% endblock %}

{% block body %}
    {% include('dashboard/_sidebar.html.twig') %}
    <div class="md:ml-64 flex flex-col min-h-screen">
        {% include('dashboard/_navbar.html.twig') %}
        <main class="flex-grow p-4 dark:bg-gray-900">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-200 mb-4">
                {% if channel_type is not null %}
                    {% trans with {'%name%': channels_types[channel_type].name} %}notifier_add_channel_title %name%{% endtrans %}
                {% else %}
                    {{ 'notifier_add_channel_title'|trans }}
                {% endif %}
            </h3>
            <div class="pt-3">
                <div class="bg-white dark:bg-gray-800 p-4 shadow-sm border rounded-lg flex gap-2">
                    {% if form is not null %}
                        {{ form(form) }}
                    {% else %}
                        {% for key, data in channels_types %}
                            <a class="btn btn-primary p-2 inline-flex items-center gap-2" href="{{ path('app_notifier_add_channel', {'type': key}) }}">
                                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                </svg>
                                <span>{{ data.name }}</span>
                            </a>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </main>
        {% include('dashboard/_flash_messages.html.twig') %}
    </div>
{% endblock %}
