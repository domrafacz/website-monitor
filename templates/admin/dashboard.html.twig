{% extends 'base.html.twig' %}

{% block title %}{{ 'admin_dashboard_title'|trans }}{% endblock %}

{% block body %}
    {% include('admin/_sidebar.html.twig') %}
    <div class="md:ml-64 flex flex-col min-h-screen">
        {% include('dashboard/_navbar.html.twig') %}
        <main class="flex-grow p-4 dark:bg-gray-900">
            <div class="mb-6">
                <h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-200">{{ 'admin_dashboard_title'|trans }}</h1>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
                <div class="bg-white dark:bg-gray-700 rounded-lg shadow-sm border dark:border-0 border-gray-200 p-6">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <div class="w-12 h-12 bg-gray-200 rounded-lg flex items-center justify-center">
                                <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="ml-4">
                            <h3 class="text-sm font-medium text-gray-500 dark:text-gray-300">{{ 'admin_user_count'|trans }}</h3>
                            <p class="text-2xl font-semibold text-gray-900 dark:text-gray-100">{{ user_count }}</p>
                        </div>
                    </div>
                </div>
                <div class="bg-white dark:bg-gray-700 rounded-lg shadow-sm border dark:border-0 border-gray-200 p-6">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <div class="w-12 h-12 bg-gray-200 rounded-lg flex items-center justify-center">
                                <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="ml-4">
                            <h3 class="text-sm font-medium text-gray-500 dark:text-gray-300">{{ 'admin_website_count_active_total'|trans }}</h3>
                            <p class="text-2xl font-semibold text-gray-900 dark:text-gray-100">{{ website_count_active }} / {{ website_count }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
{% endblock %}
