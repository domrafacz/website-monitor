{# Reusable input macros #}
{% macro password(id, name, label, required=true, value='') %}
    <div>
        <label for="{{ id }}" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">{{ label }}</label>
        <div class="relative">
            <input type="password" id="{{ id }}" name="{{ name }}" value="{{ value }}" class="js-password bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:outline-none focus-visible:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600 block w-full p-2.5 pr-10 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" {% if required %}required{% endif %}>
            <button type="button" class="js-password-toggle absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 dark:text-gray-300" aria-label="Toggle password visibility">
                <svg class="js-password-icon-show w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
                <svg class="js-password-icon-hide w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.477 0-8.268-2.943-9.542-7a9.967 9.967 0 012.223-3.574"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3l18 18"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.477 10.477A3 3 0 0113.523 13.523"></path>
                </svg>
            </button>
        </div>
    </div>
{% endmacro %}

{% macro customSelect(id, name, label, options, selectedValue='', required=false, placeholder='Select an option') %}
    <div class="js-custom-select-wrapper" data-select-id="{{ id }}">
        <label for="{{ id }}" class="block mb-2 text-sm font-medium text-gray-900 dark:text-gray-300">{{ label }}</label>
        
        {# Hidden native select for form submission #}
        <select id="{{ id }}" name="{{ name }}" class="js-custom-select-native hidden" {% if required %}required{% endif %}>
            {% for option in options %}
                <option value="{{ option.value }}" {% if option.value == selectedValue %}selected{% endif %}>{{ option.label }}</option>
            {% endfor %}
        </select>
        
        {# Custom styled select #}
        <div class="relative">
                    <button type="button" 
                        class="js-custom-select-trigger bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:outline-none focus-visible:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600 block w-full px-3 py-2 pr-10 text-left h-10 sm:h-10 leading-5 dark:bg-gray-700 dark:border-gray-600 dark:text-white transition-colors"
                    aria-haspopup="listbox"
                    aria-expanded="false">
                <span class="js-custom-select-value block truncate">{{ placeholder }}</span>
                <span class="absolute inset-y-0 right-0 flex items-center pr-2.5 pointer-events-none">
                    <svg class="w-5 h-5 text-gray-400 transition-transform js-custom-select-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </span>
            </button>
            
            {# Dropdown menu #}
            <div class="js-custom-select-dropdown hidden absolute z-10 w-full mt-1 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg shadow-lg max-h-60 overflow-auto">
                <ul class="py-1" role="listbox">
                    {% for option in options %}
                        <li class="js-custom-select-option px-3 py-2 cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-600 text-gray-900 dark:text-white transition-colors"
                            data-value="{{ option.value }}"
                            role="option">
                            {{ option.label }}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
{% endmacro %}
