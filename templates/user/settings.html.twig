{% extends 'base.html.twig' %}

{% block title %}{{ 'user_settings_title'|trans }}{% endblock %}

{% block body %}
    {% include('dashboard/_sidebar.html.twig') %}
    <div class="md:ml-64 flex flex-col min-h-screen">
        {% include('dashboard/_navbar.html.twig') %}
        <main class="flex-grow p-4 dark:bg-gray-900">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-200 mb-4">{{ 'user_settings_title'|trans }}</h3>
            {% include('dashboard/_flash_messages.html.twig') %}
            <div class="pt-3">
                <div class="md:flex">
                    <div class="md:w-1/4">
                        <ul class="space-y-2">
                            <li>
                                <a href="#general" class="block px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 dark:bg-gray-700 dark:text-white rounded-md settings-tab-item active">
                                    {{ 'settings_general'|trans }}
                                </a>
                            </li>
                            <li>
                                <a href="#change-password" class="block px-4 py-2 text-sm font-medium text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-gray-300 rounded-md settings-tab-item">
                                    {{ 'settings_change_password'|trans }}
                                </a>
                            </li>
                            <li>
                                <a href="#delete-account" class="block px-4 py-2 text-sm font-medium text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-gray-300 rounded-md settings-tab-item">
                                    {{ 'settings_delete_account'|trans }}
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="md:w-3/4 md:ml-4 mt-4 md:mt-0">
                        <div id="general" class="p-4 bg-white dark:bg-gray-800 shadow-md rounded-lg settings-tab-pane">
                            {{ form(form_general_settings) }}
                        </div>
                        <div id="change-password" class="hidden p-4 bg-white dark:bg-gray-800 shadow-md rounded-lg settings-tab-pane">
                            {{ form(form_change_password) }}
                        </div>
                        <div id="delete-account" class="hidden p-4 bg-white dark:bg-gray-800 shadow-md rounded-lg settings-tab-pane">
                            {{ form(form_delete_user) }}
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
{% endblock %}